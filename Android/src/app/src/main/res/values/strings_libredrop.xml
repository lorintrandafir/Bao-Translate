 Strings for the LibreDrop UI controls added when the send and receive paths were wired up.
 A separate values file (aapt merges every file in res/values/) keeps the monolithic strings.xml
 from growing further; new LibreDrop copy belongs here.
-->
<resources>
    <!-- File staging controls. The picker had no affordance at all before these existed. -->
    <string name="libre_drop_add_files">Add</string>
    <!-- %1$s is the file name, e.g. "Remove holiday.jpg". Spoken by TalkBack on the remove icon. -->
    <string name="libre_drop_remove_file">Remove %1$s</string>

    <!-- Receive-mode card. Controls the inbound foreground-service listener. -->
    <string name="libre_drop_receive_title">Receive files</string>
    <string name="libre_drop_receive_on_subtitle">Visible to nearby devices</string>
    <string name="libre_drop_receive_off_subtitle">Turn on to let nearby devices send you files</string>
</resources>
